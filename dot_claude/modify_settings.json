#!/bin/sh
input="$(cat)"
[ -z "$input" ] && input='{}'
# jaq preferred; jq is the fallback (e.g. Fedora's first apply, before mise
# has installed jaq).
for j in jaq jq; do
  if command -v "$j" >/dev/null 2>&1; then
    printf '%s' "$input" | "$j" '.statusLine = {"type": "command", "command": "bash ~/.claude/statusline-command.sh"}'
    exit
  fi
done
echo "modify_settings.json: jaq/jq not found, statusLine not set" >&2
printf '%s\n' "$input"
