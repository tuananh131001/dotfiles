#!/usr/bin/env bash
# Register local herdr plugins kept in ~/.config/herdr/plugins.
# Re-runs when a manifest changes:
#   link-hints: {{ include "dot_config/herdr/plugins/link-hints/herdr-plugin.toml" | sha256sum }}
#   tailscale-login: {{ include "dot_config/herdr/plugins/tailscale-login/herdr-plugin.toml" | sha256sum }}
# tailscale-login installs its launchd watcher from its herdr startup hook.
set -euo pipefail
command -v herdr >/dev/null || exit 0
plugins=$(herdr plugin list --json)
link() {
  grep -q "\"plugin_id\":\"$1\"" <<<"$plugins" || herdr plugin link "$HOME/.config/herdr/plugins/$2"
}
link local.link-hints link-hints
{{ if eq .chezmoi.os "darwin" -}}
link local.tailscale-login tailscale-login
{{ end -}}
