#!/bin/sh
set -eu

case ${1:-} in
  down) border=up; dim=pane_rows ;;
  right) border=left; dim=pane_columns ;;
  *) echo "usage: zellij-sized-split down|right PERCENT" >&2; exit 2 ;;
esac
percent=${2:-20}

panes() {
  zellij action list-panes --all --json
}

target=$(panes | jq -r --argjson self "$ZELLIJ_PANE_ID" '
  (map(select(.id == $self and (.is_plugin | not))) | first | .tab_id) as $tab
  | map(select(.tab_id == $tab and .is_focused and (.is_floating | not) and (.is_plugin | not)))
  | first | .id // empty')
[ -n "$target" ] || exit 1

size() {
  panes | jq -r --argjson id "$target" --arg dim "$dim" \
    'map(select(.id == $id and (.is_plugin | not))) | first | .[$dim]'
}

current=$(size)
goal=$((current * 2 * percent / 100))
while [ "$current" -gt "$goal" ]; do
  zellij action resize --pane-id "terminal_$target" decrease "$border"
  previous=$current
  current=$(size)
  [ "$current" -lt "$previous" ] || break
done
