keybinds clear-defaults=true {
    locked {
        bind "Ctrl a" { SwitchToMode "Tmux"; }
    }
    tmux {
        bind "Ctrl a" { Write 1; SwitchToMode "Locked"; }
        bind "Esc" "Ctrl c" { SwitchToMode "Locked"; }
        bind "n" { NewTab; SwitchToMode "Locked"; }
        bind "s" { NewPane "Down"; SwitchToMode "Locked"; }
        bind "v" { NewPane "Right"; SwitchToMode "Locked"; }
        bind "-" {
            NewPane "Down";
            Run "zellij-sized-split" "down" "20" {
                floating true
                close_on_exit true
            };
            SwitchToMode "Locked";
        }
        bind "\\" {
            NewPane "Right";
            Run "zellij-sized-split" "right" "20" {
                floating true
                close_on_exit true
            };
            SwitchToMode "Locked";
        }
        bind "_" "|" { ToggleFloatingPanes; SwitchToMode "Locked"; }
        bind "x" { CloseFocus; SwitchToMode "Locked"; }
        bind "X" { CloseTab; SwitchToMode "Locked"; }
        bind "K" {
            Run "zellij-close-other-tabs" {
                floating true
                close_on_exit true
            };
            SwitchToMode "Locked";
        }
        bind "o" "S" {
            LaunchOrFocusPlugin "zellij:session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Locked";
        }
        bind "r" { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "<" { MoveTab "Left"; }
        bind ">" { MoveTab "Right"; }
        bind "[" { SwitchToMode "Scroll"; }
        bind "e" { EditScrollback; SwitchToMode "Locked"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Locked"; }
        bind "d" { Detach; }
        bind "Ctrl r" { SwitchToMode "Resize"; }
        bind "1" { GoToTab 1; SwitchToMode "Locked"; }
        bind "2" { GoToTab 2; SwitchToMode "Locked"; }
        bind "3" { GoToTab 3; SwitchToMode "Locked"; }
        bind "4" { GoToTab 4; SwitchToMode "Locked"; }
        bind "5" { GoToTab 5; SwitchToMode "Locked"; }
        bind "6" { GoToTab 6; SwitchToMode "Locked"; }
        bind "7" { GoToTab 7; SwitchToMode "Locked"; }
        bind "8" { GoToTab 8; SwitchToMode "Locked"; }
        bind "9" { GoToTab 9; SwitchToMode "Locked"; }
    }
    resize {
        bind "h" "Left" { Resize "Increase Left"; }
        bind "j" "Down" { Resize "Increase Down"; }
        bind "k" "Up" { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
        bind "=" "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
        bind "Esc" "Enter" "q" "Ctrl c" { SwitchToMode "Locked"; }
    }
    scroll {
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl d" "d" { HalfPageScrollDown; }
        bind "Ctrl u" "u" { HalfPageScrollUp; }
        bind "Ctrl f" "PageDown" { PageScrollDown; }
        bind "Ctrl b" "PageUp" { PageScrollUp; }
        bind "g" { ScrollToTop; }
        bind "G" { ScrollToBottom; }
        bind "[" { ScrollToPreviousPrompt; }
        bind "]" { ScrollToNextPrompt; }
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "e" { EditScrollback; SwitchToMode "Locked"; }
        bind "y" { CopyLastCommandOutput; ScrollToBottom; SwitchToMode "Locked"; }
        bind "q" "Esc" "Ctrl c" { ScrollToBottom; SwitchToMode "Locked"; }
    }
    entersearch {
        bind "Enter" { SwitchToMode "Search"; }
        bind "Esc" "Ctrl c" { SwitchToMode "Scroll"; }
    }
    search {
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl d" "d" { HalfPageScrollDown; }
        bind "Ctrl u" "u" { HalfPageScrollUp; }
        bind "n" { Search "up"; }
        bind "N" { Search "down"; }
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
        bind "q" "Esc" "Ctrl c" { ScrollToBottom; SwitchToMode "Locked"; }
    }
    renametab {
        bind "Enter" { SwitchToMode "Locked"; }
        bind "Esc" "Ctrl c" { UndoRenameTab; SwitchToMode "Locked"; }
    }
    normal {
        bind "Esc" "Ctrl a" { SwitchToMode "Locked"; }
    }
    shared_among "locked" "scroll" "search" {
        bind "Ctrl h" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus_or_tab";
                payload "left";
            };
        }
        bind "Ctrl j" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "down";
            };
        }
        bind "Ctrl k" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "up";
            };
        }
        bind "Ctrl l" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus_or_tab";
                payload "right";
            };
        }
    }
}

themes {
    monokai-pro {
        fg "#fcfcfa"
        bg "#403e41"
        black "#19181a"
        red "#ff6188"
        green "#a9dc76"
        yellow "#ffd866"
        blue "#78dce8"
        magenta "#ab9df2"
        cyan "#78dce8"
        white "#fcfcfa"
        orange "#fc9867"
    }
}

theme "monokai-pro"
default_mode "locked"
default_layout "monokai"
default_shell "fish"
mouse_mode true
copy_on_select true
scrollback_editor "nvim"
pane_frames false
support_kitty_keyboard_protocol true
scroll_buffer_size 50000
session_serialization true
serialize_pane_viewport true
scrollback_lines_to_serialize 1000
show_release_notes false
show_startup_tips false
